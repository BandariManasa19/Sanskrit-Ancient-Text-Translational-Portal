# Environment Configuration for Ancient Text Translational Portal

# Application Settings
APP_NAME="Ancient Text Translational Portal"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration
# For SQLite (development):
DATABASE_URL=sqlite:///./ancient_text_portal.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/ancient_text_portal

# JWT Authentication
# IMPORTANT: Change this secret key in production!
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Tesseract OCR Path (if not in system PATH)
# TESSERACT_CMD=/usr/local/bin/tesseract
